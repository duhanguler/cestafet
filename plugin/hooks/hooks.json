{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "cestafet hook session-start", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "cestafet hook prompt", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "cestafet hook pre-tool", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "cestafet hook post-tool", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "cestafet hook session-end", "timeout": 5 }] }
    ]
  }
}
